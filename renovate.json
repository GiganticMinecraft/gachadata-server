{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>GiganticMinecraft/renovate-config",
    ":dependencyDashboard"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry-otlp",
        "opentelemetry_sdk",
        "tracing-opentelemetry",
        "axum-tracing-opentelemetry",
        "json-subscriber"
      ],
      "groupName": "OpenTelemetry"
    },
    {
      "description": "MariaDB 11.4.7 のリポジトリ設定が Ubuntu 26.04 (resolute) に未対応のため、ubuntu イメージを更新しない",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "enabled": false
    }
  ]
}
