{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>GiganticMinecraft/renovate-config",
    ":dependencyDashboard"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry-otlp",
        "opentelemetry_sdk",
        "tracing-opentelemetry",
        "axum-tracing-opentelemetry",
        "json-subscriber"
      ],
      "groupName": "OpenTelemetry"
    }
  ]
}
